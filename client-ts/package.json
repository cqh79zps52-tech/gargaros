{
  "name": "@gargaros/client",
  "version": "0.6.0",
  "description": "Node.js client for the Gargaros Named-Pipe binary protocol. Used by Claude Code hooks and subagents to control the Windows desktop.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gargaros": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0"
  }
}
