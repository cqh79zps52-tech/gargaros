{
  "manifest_version": 3,
  "name": "Gargaros Bridge",
  "version": "0.3.0",
  "description": "Bridges Chrome/Edge to a local Gargaros server (http://127.0.0.1:7331) so AI agents can drive browser tabs.",
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:7331/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Gargaros Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
